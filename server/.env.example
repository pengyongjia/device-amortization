# 服务端口
PORT=8787

# SQLite 数据库文件路径
DB_PATH=./data/app.db

# 前端静态资源目录（相对启动目录）。前后端同端口部署时由本服务直接托管
STATIC_DIR=../dist

# 前端地址（CORS 白名单，支持逗号分隔多个；同源部署自动放行）
APP_ORIGIN=http://localhost:5173,http://localhost:8080

# 会话有效期（天）
SESSION_TTL_DAYS=180

# ============ 登录验证码（邮箱 OTP）============

# 验证码有效期（分钟）
CODE_TTL_MINUTES=10
# 单个验证码允许输错的次数，超出即作废、需重新获取
MAX_CODE_ATTEMPTS=5

# 演示模式：未配置任何发信通道时，是否把验证码随接口返回（前端直接显示，免收发邮件）。
# 不设置时：非生产环境默认开启，NODE_ENV=production 时默认关闭。
# ⚠️ 开启且未配邮件 = 任何人只要知道邮箱就能登录，仅限自用/演示。
DEV_SHOW_CODE=

# ============ 邮件发送（三选一，都留空则进入演示模式） ============

# 方式一（通用推荐）：SMTP —— QQ 邮箱 / 163 / 企业邮箱等均可
# QQ 邮箱：设置 → 账户 → 开启「POP3/SMTP 服务」→ 生成授权码（填 SMTP_PASS，不是QQ密码）
# 授权码在 https://mail.qq.com 网页端设置获取
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人显示名（留空则自动使用「设备摊销 <SMTP_USER>」）
SMTP_FROM=

# 方式二：QQ Agent Mail（xxx@agent.qq.com，与个人邮箱隔离；50 封/天）
# 启用步骤：
#   1. 微信扫码登录 https://agent.qq.com 创建邮箱地址
#   2. server 目录执行：npm install（已内置 agently-cli 依赖）
#   3. 完成授权：node node_modules/@tencent-qqmail/agently-cli/scripts/run.js auth login
#   4. 将下方 AGENT_MAIL 改为 true 并重启
AGENT_MAIL=
# 若使用全局安装的 agently-cli，可指定其入口路径：
# AGENTLY_CLI_ENTRY=

# 方式三：Resend（海外服务，免费 100 封/天；未验证域名时只能发给注册邮箱）
RESEND_API_KEY=
MAIL_FROM=设备摊销 <noreply@yourdomain.com>

# 生产环境设为 production（会关闭演示模式直返验证码）
# NODE_ENV=production

# ============ 运维统计（可选）============

# /api/admin/stats 的访问令牌。留空则该接口返回 404（默认关闭）。
# 配置后：curl -H "X-Admin-Token: <令牌>" /api/admin/stats
# 可查看用户列表与各自的云同步概况。
ADMIN_TOKEN=
